target 'LTios' do
    # Comment the next line if you're not using Swift and don't want to use dynamic frameworks
    use_frameworks!
    
    # Pods for LTios
    pod 'Firebase/Core'
    pod 'Firebase/Auth'
    pod 'Firebase/Database'
    pod 'Firebase/Storage'
    pod 'SnapKit'
    pod 'Pulsator'
    pod 'Whisper'
    pod 'ReachabilitySwift'
    pod 'CryptoSwift'
    pod 'PhoneNumberKit'
    pod 'SCLAlertView'
    pod 'SwiftyJSON'
    pod 'TextFieldEffects'
    pod 'NexmoVerify'
    pod 'GooglePlaces'
    pod 'SRCountdownTimer'
    pod 'Spring'
    pod 'FSPagerView'
    
    target 'LTiosTests' do
        inherit! :search_paths
        # Pods for testing
    end
    
    target 'LTiosUITests' do
        inherit! :search_paths
        # Pods for testing
    end
    
end
